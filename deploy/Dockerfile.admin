FROM node:20.19-alpine AS build
RUN corepack enable && corepack prepare pnpm@10.33.0 --activate
WORKDIR /workspace

COPY yudao-ui/yudao-ui-admin-vue3/package.json \
     yudao-ui/yudao-ui-admin-vue3/pnpm-lock.yaml \
     yudao-ui/yudao-ui-admin-vue3/.npmrc ./
RUN pnpm install --frozen-lockfile

COPY yudao-ui/yudao-ui-admin-vue3/ ./
ARG VITE_BASE_URL=
ARG VITE_API_URL=/admin-api
ARG VITE_APP_TITLE=Hotel PMS Community
ARG VITE_APP_CAPTCHA_ENABLE=true
ENV VITE_BASE_URL=${VITE_BASE_URL} \
    VITE_API_URL=${VITE_API_URL} \
    VITE_APP_TITLE=${VITE_APP_TITLE} \
    VITE_APP_CAPTCHA_ENABLE=${VITE_APP_CAPTCHA_ENABLE}
RUN pnpm build

FROM nginx:1.27-alpine
COPY deploy/nginx/default.conf /etc/nginx/conf.d/default.conf
COPY --from=build /workspace/dist/ /usr/share/nginx/html/
EXPOSE 8080
