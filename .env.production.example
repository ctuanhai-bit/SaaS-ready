# Copy this file to .env.production and replace every empty required value.
MYSQL_DATABASE=hotel_pms_community
MYSQL_USER=hotel_pms
MYSQL_PASSWORD=
MYSQL_ROOT_PASSWORD=

REDIS_PASSWORD=
REDIS_DATABASE=0

# Public origin only, without a trailing slash. TLS should terminate at the
# host reverse proxy, load balancer, or ingress in front of ADMIN_HTTP_PORT.
PUBLIC_BASE_URL=https://hotel.example.com
ADMIN_HTTP_PORT=8080
ADMIN_TITLE=Hotel PMS Community

MYBATIS_ENCRYPTOR_PASSWORD=
CAPTCHA_ENABLED=true
SWAGGER_ENABLED=false

JAVA_OPTS=-Xms512m -Xmx1024m -XX:+UseContainerSupport
LOG_LEVEL=INFO
